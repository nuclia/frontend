{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2023",
    "module": "esnext",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2023", "dom", "esnext.asynciterable", "esnext.bigint"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "paths": {
      "@flaps/common": ["./libs/common/src/index.ts"],
      "@flaps/core": ["./libs/core/src/index.ts"],
      "@guillotinaweb/pastanaga-angular": ["./libs/pastanaga-angular/projects/pastanaga-angular/src"],
      "@guillotinaweb/pastanaga-angular/demo": ["./libs/pastanaga-angular/projects/demo/src/index.ts"],
      "@nuclia/core": ["./libs/sdk-core/src/index.ts"],
      "@nuclia/sistema": ["./libs/sistema/src/index.ts"],
      "@nuclia/sync": ["./libs/sync/src/index.ts"],
      "@nuclia/user": ["./libs/user/src/index.ts"],
      "@nuclia/widget": ["./libs/search-widget/src/index.ts"],
      "@nuclia/ui": ["./libs/ui/src/index.ts"],
      "libs": ["./libs/src/index.ts"],
      "*": ["./*"],
      "@nuclia/ui-spartan": ["./libs/ui/src/lib/spartan-components/src/index.ts"],
      "@nuclia/ui-spartan/accordion": ["./libs/ui/src/lib/spartan-components/accordion/src/index.ts"],
      "@nuclia/ui-spartan/avatar": ["./libs/ui/src/lib/spartan-components/avatar/src/index.ts"],
      "@nuclia/ui-spartan/button": ["./libs/ui/src/lib/spartan-components/button/src/index.ts"],
      "@nuclia/ui-spartan/utils": ["./libs/ui/src/lib/spartan-components/utils/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": false,
    "strictInjectionParameters": true
  },
  "exclude": ["node_modules", "tmp"]
}
