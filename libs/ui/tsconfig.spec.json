{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "target": "es2016",
    "typeRoots": ["../../node_modules/@types", "../../node_modules"],
    "types": ["vitest/globals", "node"],
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
