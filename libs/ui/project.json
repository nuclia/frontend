{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test-build": {
      "executor": "@angular/build:application",
      "options": {
        "tsConfig": "libs/ui/tsconfig.spec.json",
        "outputPath": "dist/test-build/ui",
        "polyfills": [],
        "styles": [],
        "assets": [],
        "aot": false,
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/ui"],
      "options": {
        "buildTarget": "ui:test-build",
        "tsConfig": "libs/ui/tsconfig.spec.json",
        "runnerConfig": true,
        "watch": false
      },
      "configurations": {
        "ci": {
          "coverage": true
        },
        "watch": {
          "watch": true
        }
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "port": 4400,
        "configDir": "libs/ui/.storybook",
        "browserTarget": "ui:build-storybook",
        "compodoc": false,
        "styles": ["libs/ui/.storybook/storybook-styles.css"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ui",
        "configDir": "libs/ui/.storybook",
        "browserTarget": "ui:build-storybook",
        "compodoc": false,
        "styles": ["libs/ui/.storybook/storybook-styles.css"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "ui:build-storybook",
        "staticFilePath": "dist/storybook/ui",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ui:build-storybook:ci"
        }
      }
    }
  }
}
