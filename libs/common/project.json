{
  "name": "common",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/common/src",
  "prefix": "stf",
  "tags": [],
  "generators": {
    "@nx/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush"
    }
  },
  "targets": {
    "test-build": {
      "executor": "@angular/build:application",
      "options": {
        "tsConfig": "libs/common/tsconfig.spec.json",
        "outputPath": "dist/test-build/common",
        "polyfills": [],
        "styles": [],
        "assets": [],
        "aot": false,
        "stylePreprocessorOptions": {
          "includePaths": ["libs/sistema/styles", "."]
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/common"],
      "options": {
        "buildTarget": "common:test-build",
        "tsConfig": "libs/common/tsconfig.spec.json",
        "providersFile": "test/translate-test-provider.ts",
        "setupFiles": ["libs/common/src/test-setup.ts"],
        "runnerConfig": true,
        "watch": false
      },
      "configurations": {
        "ci": {
          "coverage": true
        },
        "watch": {
          "watch": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
