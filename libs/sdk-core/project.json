{
  "name": "sdk-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sdk-core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "dependsOn": ["test-typecheck"]
    },
    "test-typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/yarn.lock"],
      "options": {
        "command": "yarn tsc --project libs/sdk-core/tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["yarn sdk-build"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
