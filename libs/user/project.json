{
  "name": "user",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/user/src",
  "prefix": "nus",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test-build": {
      "executor": "@angular/build:application",
      "options": {
        "tsConfig": "libs/user/tsconfig.spec.json",
        "outputPath": "dist/test-build/user",
        "polyfills": [],
        "styles": [],
        "assets": [],
        "aot": false,
        "stylePreprocessorOptions": {
          "includePaths": ["libs/sistema/styles", "."]
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/user"],
      "options": {
        "buildTarget": "user:test-build",
        "tsConfig": "libs/user/tsconfig.spec.json",
        "providersFile": "test/translate-test-provider.ts",
        "runnerConfig": true,
        "watch": false
      },
      "configurations": {
        "ci": {
          "coverage": true
        },
        "watch": {
          "watch": true
        }
      }
    }
  }
}
