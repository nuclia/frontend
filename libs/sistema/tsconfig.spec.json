{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "types": ["vitest/globals", "node"],
    "typeRoots": ["../../node_modules/@types", "../../node_modules"],
    "target": "es2016",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false
  },
  "include": ["**/*.test.ts", "**/*.spec.ts", "**/*.d.ts"]
}
