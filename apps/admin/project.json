{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin/src",
  "prefix": "app",
  "tags": [],
  "generators": {
    "@nx/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/admin",
          "browser": ""
        },
        "subresourceIntegrity": false,
        "index": "apps/admin/src/index.html",
        "polyfills": ["apps/admin/src/polyfills.ts"],
        "tsConfig": "apps/admin/tsconfig.app.json",
        "allowedCommonJsDependencies": [],
        "assets": [
          "apps/admin/src/favicon.ico",
          "apps/admin/src/assets",
          "apps/admin/src/manifest.webmanifest",
          {
            "glob": "**/*",
            "input": "libs/pastanaga/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/common/src/assets/i18n",
            "output": "assets/i18n/common"
          },
          {
            "glob": "**/*",
            "input": "libs/user/src/assets/i18n",
            "output": "assets/i18n/user"
          },
          {
            "glob": "**/*",
            "input": "libs/sync/src/assets/i18n",
            "output": "assets/i18n/sync"
          },
          {
            "glob": "**/*",
            "input": "apps/admin/src/environments_config/local",
            "output": "assets/deployment"
          },
          {
            "glob": "**/*",
            "input": "libs/sistema/assets",
            "output": "assets"
          }
        ],
        "styles": ["apps/admin/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["apps/admin/src", "."]
        },
        "scripts": [],
        "budgets": [
          {
            "type": "initial",
            "maximumWarning": "2mb",
            "maximumError": "30mb"
          },
          {
            "type": "anyComponentStyle",
            "maximumWarning": "50kb",
            "maximumError": "100kb"
          }
        ],
        "browser": "apps/admin/src/main.ts",
        "serviceWorker": false
      },
      "configurations": {
        "production": {
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          },
          "outputHashing": "all",
          "serviceWorker": "apps/admin/src/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "apps/admin/src/environments/environment.ts",
              "with": "apps/admin/src/environments/environment.prod.ts"
            }
          ],
          "assets": [
            "apps/admin/src/favicon.ico",
            "apps/admin/src/assets",
            "apps/admin/src/manifest.webmanifest",
            {
              "glob": "**/*",
              "input": "libs/pastanaga/src/assets",
              "output": "assets"
            },
            {
              "glob": "**/*",
              "input": "libs/common/src/assets/i18n",
              "output": "assets/i18n/common"
            },
            {
              "glob": "**/*",
              "input": "libs/user/src/assets/i18n",
              "output": "assets/i18n/user"
            },
            {
              "glob": "**/*",
              "input": "libs/sync/src/assets/i18n",
              "output": "assets/i18n/sync"
            },
            {
              "glob": "**/*",
              "input": "apps/admin/src/environments_config/production",
              "output": "assets/deployment"
            },
            {
              "glob": "**/*",
              "input": "libs/sistema/assets",
              "output": "assets"
            }
          ]
        },
        "local-stage": {
          "aot": false,
          "subresourceIntegrity": false,
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "assets": [
            "apps/admin/src/favicon.ico",
            "apps/admin/src/assets",
            "apps/admin/src/manifest.webmanifest",
            {
              "glob": "**/*",
              "input": "libs/pastanaga/src/assets",
              "output": "assets"
            },
            {
              "glob": "**/*",
              "input": "libs/common/src/assets/i18n",
              "output": "assets/i18n/common"
            },
            {
              "glob": "**/*",
              "input": "libs/user/src/assets/i18n",
              "output": "assets/i18n/user"
            },
            {
              "glob": "**/*",
              "input": "libs/sync/src/assets/i18n",
              "output": "assets/i18n/sync"
            },
            {
              "glob": "**/*",
              "input": "apps/admin/src/environments_config/local-stage",
              "output": "assets/deployment"
            },
            {
              "glob": "**/*",
              "input": "libs/sistema/assets",
              "output": "assets"
            }
          ]
        },
        "local-dev": {
          "aot": false,
          "subresourceIntegrity": false,
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "assets": [
            "apps/admin/src/favicon.ico",
            "apps/admin/src/assets",
            "apps/admin/src/manifest.webmanifest",
            {
              "glob": "**/*",
              "input": "libs/pastanaga/src/assets",
              "output": "assets"
            },
            {
              "glob": "**/*",
              "input": "libs/common/src/assets/i18n",
              "output": "assets/i18n/common"
            },
            {
              "glob": "**/*",
              "input": "libs/user/src/assets/i18n",
              "output": "assets/i18n/user"
            },
            {
              "glob": "**/*",
              "input": "libs/sync/src/assets/i18n",
              "output": "assets/i18n/sync"
            },
            {
              "glob": "**/*",
              "input": "apps/admin/src/environments_config/local-dev",
              "output": "assets/deployment"
            },
            {
              "glob": "**/*",
              "input": "libs/sistema/assets",
              "output": "assets"
            }
          ]
        },
        "local-prod": {
          "aot": false,
          "subresourceIntegrity": false,
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "assets": [
            "apps/admin/src/favicon.ico",
            "apps/admin/src/assets",
            "apps/admin/src/manifest.webmanifest",
            {
              "glob": "**/*",
              "input": "libs/pastanaga/src/assets",
              "output": "assets"
            },
            {
              "glob": "**/*",
              "input": "libs/common/src/assets/i18n",
              "output": "assets/i18n/common"
            },
            {
              "glob": "**/*",
              "input": "libs/user/src/assets/i18n",
              "output": "assets/i18n/user"
            },
            {
              "glob": "**/*",
              "input": "libs/sync/src/assets/i18n",
              "output": "assets/i18n/sync"
            },
            {
              "glob": "**/*",
              "input": "apps/admin/src/environments_config/local-prod",
              "output": "assets/deployment"
            },
            {
              "glob": "**/*",
              "input": "libs/sistema/assets",
              "output": "assets"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "local-stage",
      "continuous": true,
      "options": {
        "buildTarget": "admin:build",
        "port": 4300
      },
      "configurations": {
        "production": {
          "buildTarget": "admin:build:production"
        },
        "local-stage": {
          "buildTarget": "admin:build:local-stage"
        },
        "local-dev": {
          "buildTarget": "admin:build:local-dev"
        },
        "local-prod": {
          "buildTarget": "admin:build:local-prod"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "admin:build"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
